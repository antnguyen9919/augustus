// Packed city statistics, one STAT(name, expression) per entry. The order defines the index
// in the array returned by aug_stats(); tools/gen_stats.py turns this file into TypeScript.
// Gods: Ceres 0, Neptune 1, Mercury 2, Mars 3, Venus 4 (the same order as the engine).

STAT(POPULATION, city_population())
STAT(TREASURY, city_finance_treasury())
STAT(TAX_PERCENTAGE, city_finance_tax_percentage())
STAT(WAGES, city_labor_wages())
STAT(WAGES_ROME, city_labor_wages_rome())
STAT(UNEMPLOYMENT_PERCENTAGE, city_labor_unemployment_percentage())
STAT(WORKERS_NEEDED, city_labor_workers_needed())
STAT(WORKERS_UNEMPLOYED, city_labor_workers_unemployed())
STAT(SENTIMENT, city_sentiment())
STAT(LOW_MOOD_CAUSE, city_sentiment_low_mood_cause())
STAT(HEALTH, city_health())
STAT(RATING_CULTURE, city_rating_culture())
STAT(RATING_PROSPERITY, city_rating_prosperity())
STAT(RATING_PEACE, city_rating_peace())
STAT(RATING_FAVOR, city_rating_favor())
STAT(FOOD_STORED, city_resource_food_stored())
STAT(FOOD_NEEDED, city_resource_food_needed())
STAT(FOOD_SUPPLY_MONTHS, city_resource_food_supply_months())
STAT(FOOD_TYPES_EATEN, city_resource_food_types_eaten())
STAT(PROTESTERS, city_sentiment_protesters())
STAT(CRIMINALS, city_sentiment_criminals())
STAT(LEGIONS, city_military_total_legions())
STAT(SOLDIERS, city_military_total_soldiers())
STAT(ENEMIES, city_figures_enemies())
STAT(RIOTERS, city_figures_rioters())
STAT(INVASION_UPCOMING, scenario_invasion_exists_upcoming())
STAT(INVASION_YEARS_REMAINING, scenario_invasion_get_years_remaining())
STAT(NATIVE_ATTACK, city_military_is_native_attack_active())
STAT(FESTIVAL_PLANNED, city_festival_is_planned())
STAT(MONTHS_SINCE_FESTIVAL, city_festival_months_since_last())
STAT(HOUSING_CAPACITY, city_population_open_housing_capacity())
STAT(BUILDINGS_ACTIVE, building_count_any_total(1))
STAT(GRAND_TEMPLES, building_count_grand_temples_active())
STAT(ORACLES, building_count_active(BUILDING_ORACLE))
STAT(PANTHEONS, building_count_active(BUILDING_PANTHEON))
STAT(AVG_ENTERTAINMENT, city_culture_average_entertainment())
STAT(AVG_EDUCATION, city_culture_average_education())
STAT(AVG_HEALTH, city_culture_average_health())
STAT(LAND_TRADE_PROBLEMS, city_trade_has_land_trade_problems())
