STAT(HAS_LAND_ROUTE, city_trade_has_land_trade_route())
STAT(HAS_SEA_ROUTE, city_trade_has_sea_trade_route())
STAT(EARTHQUAKE_IN_PROGRESS, scenario_earthquake_is_in_progress())
STAT(YEAR, game_time_year())
STAT(MONTH, game_time_month())
STAT(DAY, game_time_day())
STAT(TICK, game_time_tick())
STAT(MAP_WIDTH, map_grid_width())
STAT(MAP_HEIGHT, map_grid_height())
STAT(CLIMATE, scenario_property_climate())
STAT(GOD_HAPPINESS_CERES, city_god_happiness(GOD_CERES))
